{
  "name": "digital400-storycraft",
  "version": "0.1.3",
  "description": "Simple configurable story-crafting tool for Digital400 (Pvt) Ltd",
  "type": "module",
  "private": false,
  "bin": {
    "storycraft": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "storycraft": "node src/cli.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -I{} node --check {}",
    "check:templates": "node src/scripts/validate-template-secrets.js",
    "prepublishOnly": "npm run check && npm run check:templates"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital400/DigiCraft.git"
  },
  "files": [
    "src",
    "config/default.config.json",
    "README.md",
    ".env.example"
  ],
  "license": "UNLICENSED"
}
